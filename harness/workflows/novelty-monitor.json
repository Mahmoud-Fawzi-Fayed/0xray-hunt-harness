{
  "id": "noveltymonitor01",
  "name": "novelty-monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Every 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "__HUNT_BRIDGE_URL__/targets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Hunt-Token",
              "value": "__HUNT_BRIDGE_TOKEN__"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Live programs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const list = ($json.targets || []).filter(t => t && (t.target || t.name));\nreturn list.map(t => ({ json: { target: String(t.target || t.name).replace(/^https?:\\/\\//, '') } }));"
      },
      "id": "a25252525-2222-4222-8222-222222222225",
      "name": "Split apexes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "__HUNT_BRIDGE_URL__/novelty/watch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Hunt-Token",
              "value": "__HUNT_BRIDGE_TOKEN__"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ target: $json.target }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Bridge: novelty/watch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.has_changes }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Every 6h": {
      "main": [
        [
          {
            "node": "Live programs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Live programs": {
      "main": [
        [
          {
            "node": "Split apexes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split apexes": {
      "main": [
        [
          {
            "node": "Bridge: novelty/watch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bridge: novelty/watch": {
      "main": [
        [
          {
            "node": "Changed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Changed?": {
      "main": [
        [],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
