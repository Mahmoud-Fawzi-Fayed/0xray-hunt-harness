# 0xRay Hunt Harness — configuration + secrets (SINGLE SOURCE OF TRUTH)
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values:   cp .env.example .env && chmod 600 .env
# `.env` is gitignored on purpose — NEVER commit real secrets.
# This file documents every key the bridge, n8n, and engine read.

# --- Host bridge (token-gated control plane on the host) ----------------------
# Generate a long random token, e.g.:  openssl rand -hex 32
HUNT_BRIDGE_TOKEN=change-me-generate-a-long-random-token
# Bind 0.0.0.0 so the containerized n8n can reach it via host.docker.internal.
# It stays token-gated; host-side tools still call http://127.0.0.1:8899.
HUNT_BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8899
# URL the n8n WORKFLOW uses (runs inside the container). With the pinned hunt
# network + a ufw allow for :8899 on that subnet only, n8n reaches the host here:
HUNT_BRIDGE_URL=http://host.docker.internal:8899
# Where the engine keeps per-target engagement state.
BUGHUNTER_BASE=/root/.bughunter-engagements

# --- Separate hunting n8n instance (NOT any other n8n you run) -----------------
N8N_PORT=5690
GENERIC_TIMEZONE=UTC

# --- Email (fill to get finding + monitor alerts by mail) ---------------------
# Used by engine/notify.py, the bridge /notify endpoint, and the orchestrator.
# Gmail: host=smtp.gmail.com port=587 user=<you> pass=<app-password> tls=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=0xRay Hunt <you@example.com>
SMTP_TO=you@example.com
# Cc/Bcc are honored by EVERY email the harness sends (findings, monitor alerts, status).
# Comma-separate for multiple. Edit here once — it reflects everywhere (no n8n/code change).
SMTP_CC=
SMTP_BCC=
SMTP_TLS=1

# --- Public findings viewer (link placed in emails) ---------------------------
HUNT_PUBLIC_URL=https://finding.example.com
HUNT_WEB_DIR=/var/www/findings

# --- Active AI runtime (no provider fallback) -------------------------------------
# Non-interactive argv template for the AI you intentionally run. Placeholders:
# {task}=prompt, {model}=opaque pool label, {resume}=session returned by that command.
# Without {task}, the prompt is sent on stdin. Prefer --model={model} and
# --resume={resume} forms so empty host-default/fresh values remain valid.
# Example shape only: /path/to/active-agent --print --model={model} {task}
HUNT_AGENT_CMD=
# Optional comma-separated labels passed only to the command above. Empty = host default.
HUNT_MODELS=
# Optional single-label override for every model-routed task.
HUNT_MODEL_OVERRIDE=

# --- Hunt tuning --------------------------------------------------------------
HUNT_MAX_HUNTS=24          # items tested per round
HUNT_PARAMS_TTL=21600      # param-mining cache TTL (seconds, 6h)
HUNT_AGENT_TIMEOUT=300     # per-step agent timeout (seconds)
HUNT_PROVISION_TIMEOUT=600 # signup/verify/login provisioning timeout (seconds)
HUNT_PARALLEL=3            # parallel hunt workers
HUNT_SESSION_POOL=3        # active-runtime sessions kept per target when {resume} is supported
HUNT_SESSION_MAX_USES=25   # turns before a session refreshes

# --- Authenticated hunting + guardrails ---------------------------------------
HUNT_AUTH=0                # 1 = attempt authenticated hunting (disposable test accounts)
HUNT_MAX_ACCOUNTS=3        # test-account cap per target (guardrail)

# --- Phone / SMS OTP (OPTIONAL; disabled unless both are set) ------------------
# Providers: 5sim / sms-activate. Never use to defeat a victim's 2FA.
SMS_PROVIDER=
SMS_API_KEY=
SMS_COUNTRY=
